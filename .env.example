# Contact form email delivery (https://web3forms.com)
# The form submits straight from the browser, so this key is public by
# design — restrict the form to your domain in the Web3Forms dashboard,
# which is what stops anyone else using it. Relaying from the server
# instead gets Cloudflare's bot challenge rather than the API.
# Without this set, the form shows a "not configured yet" message.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Sanity CMS (see studio/ and README.md "Content — editing via Sanity")
# Without these set, the site renders bundled placeholder content instead
# of crashing. Safe to expose to the browser — that's what NEXT_PUBLIC_ is for.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed locally, to run `npm run seed:sanity` or `npm run
# update:projects`. Get a write token from https://www.sanity.io/manage —
# never commit it, never add it to Vercel (the deployed site only ever
# reads published content). For hands-off updates via GitHub Actions
# instead, add it as a repo secret — see README.md "Adding case studies".
SANITY_API_WRITE_TOKEN=
